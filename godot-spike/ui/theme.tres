corner_radius_top_right = 60
corner_radius_bottom_right = 60
corner_radius_bottom_left = 60

[resource]
default_font_size = 18
Label/colors/font_color = Color(1, 1, 1, 1)
NameLabel/base_type = &"Label"
NameLabel/styles/normal = SubResource("name_idle")
NameLabelSelected/base_type = &"Label"
NameLabelSelected/colors/font_color = Color(0, 0, 0, 1)
NameLabelSelected/styles/normal = SubResource("name_selected")
HintLabel/base_type = &"Label"
HintLabel/styles/normal = SubResource("panel_dark")
StatusBar/base_type = &"Label"
StatusBar/styles/normal = SubResource("status_bar")
HelpPanel/base_type = &"PanelContainer"
HelpPanel/styles/panel = SubResource("help_panel")
MoonButton/base_type = &"Button"
MoonButton/font_sizes/font_size = 16
MoonButton/styles/normal = SubResource("moon")
MoonButton/styles/hover = SubResource("moon_hover")
MoonButton/styles/pressed = SubResource("moon")
MoonButton/styles/focus = SubResource("moon_hover")
